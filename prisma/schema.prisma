generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id       String @id @default(cuid())
  name     String
  email    String @unique
  password String

  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  LiquidPositions LiquidPositions[]
  Stocks          Stocks[]
  Options         Options[]
  Cryptos         Cryptos[]
}

model LiquidPositions {
  id     String @id @default(cuid())
  amount Float

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  editUser   User   @relation(fields: [editUserId], references: [id])
  editUserId String
}

model Stocks {
  id            String   @id @default(cuid())
  symbol        String
  quantity      Int
  side          String
  type          String   @default("Stock")
  purchasePrice Float
  sellPrice     Float?
  debit         Float?
  credit        Float?
  tradeDate     DateTime
  status        Boolean  @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  editUser   User   @relation(fields: [editUserId], references: [id])
  editUserId String
}

model Options {
  id             String   @id @default(cuid())
  symbol         String
  quantity       Int
  tradeDate      DateTime
  expirationDate DateTime
  strike         Float
  type           String   @default("Option")
  side           String
  credit         Float?
  debit          Float?
  status         Boolean  @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  editUser   User   @relation(fields: [editUserId], references: [id])
  editUserId String
}

model Cryptos {
  id            String   @id @default(cuid())
  symbol        String
  purchasePrice Float
  quantity      Int
  type          String   @default("Crypto")
  sellPrice     Float?
  debit         Float?
  credit        Float?
  tradeDate     DateTime
  status        Boolean  @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  editUser   User   @relation(fields: [editUserId], references: [id])
  editUserId String
}
