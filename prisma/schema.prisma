generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id       String @id @default(cuid())
  name     String
  email    String @unique
  password String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // relations
  liquidPositions LiquidPositions[]
  stocks          Stocks[]
  options         Options[]
  cryptos         Cryptos[]
}

model LiquidPositions {
  id     String  @id @default(cuid())
  amount Decimal @default(0) @db.Decimal(10, 2)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // relations
  editUser   User   @relation(fields: [editUserId], references: [id])
  editUserId String
}

model Stocks {
  id        String    @id @default(cuid())
  symbol    String
  quantity  Int
  type      String    @default("Stock")
  debit     Decimal   @default(0) @db.Decimal(10, 2)
  credit    Decimal   @default(0) @db.Decimal(10, 2)
  openDate  DateTime
  closeDate DateTime?
  status    String    @default("open")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // relations
  editUser   User   @relation(fields: [editUserId], references: [id])
  editUserId String
}

enum OptionSide {
  call
  put
}

enum OptionStrategy {
  spread
  single
}

enum OptionType {
  buy
  sell
}

enum LegSide {
  short
  long
}

enum TradeStatus {
  open
  closed
}

model Options {
  id             String         @id @default(cuid())
  symbol         String
  strategy       OptionStrategy
  quantity       Int // contracts per leg (common lot size)
  openDate       DateTime
  closeDate      DateTime?
  expirationDate DateTime
  side           OptionSide // call | put
  strike         Decimal        @db.Decimal(10, 2)
  type           OptionType // buy | sell
  debit          Decimal        @default(0) @db.Decimal(10, 2)
  credit         Decimal        @default(0) @db.Decimal(10, 2)
  status         TradeStatus    @default(open)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // relations
  editUserId String
  editUser   User   @relation(fields: [editUserId], references: [id])
}

model Cryptos {
  id        String      @id @default(cuid())
  symbol    String
  quantity  Int
  type      String      @default("Crypto")
  debit     Decimal     @default(0) @db.Decimal(10, 2)
  credit    Decimal     @default(0) @db.Decimal(10, 2)
  openDate  DateTime
  closeDate DateTime?
  status    TradeStatus @default(open)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // relations
  editUser   User   @relation(fields: [editUserId], references: [id])
  editUserId String
}
