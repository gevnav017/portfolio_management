generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id       String @id @default(cuid())
  name     String
  email    String @unique
  password String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // relations
  liquidPositions LiquidPositions[]
  stocks          Stocks[]
  options         Options[]
  cryptos         Cryptos[]
}

model LiquidPositions {
  id     String @id @default(cuid())
  amount Float

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // relations
  editUser   User   @relation(fields: [editUserId], references: [id])
  editUserId String
}

model Stocks {
  id            String   @id @default(cuid())
  symbol        String
  quantity      Int
  type          String   @default("Stock")
  purchasePrice Float
  sellPrice     Float?
  tradeDate     DateTime
  status        String   @default("open")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // relations
  editUser   User   @relation(fields: [editUserId], references: [id])
  editUserId String
}

enum OptionFamily {
  call
  put
}

enum LegSide {
  short
  long
}

enum TradeStatus {
  open
  closed
}

model Options {
  id             String       @id @default(cuid())
  symbol         String
  strategy       String // "Single" | "Credit Call Spread" | ...
  family         OptionFamily // call | put (the underlying family)
  quantity       Int // contracts per leg (common lot size)
  tradeDate      DateTime
  expirationDate DateTime
  status         TradeStatus  @default(open)

  legs OptionLegs[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // relations
  editUserId String
  editUser   User   @relation(fields: [editUserId], references: [id])
}

model OptionLegs {
  id     String       @id @default(cuid())
  side   LegSide // short | long | single
  family OptionFamily // call | put
  strike Decimal      @db.Decimal(10, 2)
  price  Decimal      @db.Decimal(10, 2) // per-contract premium
  credit Decimal?     @db.Decimal(10, 2) // usually side=short => credit=price
  debit  Decimal?     @db.Decimal(10, 2) // usually side=long  => debit=price
  status TradeStatus  @default(open)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // relations
  tradeId String
  trade   Options @relation(fields: [tradeId], references: [id], onDelete: Cascade)

  @@index([tradeId])
  @@index([family, strike])
}

model Cryptos {
  id            String      @id @default(cuid())
  symbol        String
  purchasePrice Float
  quantity      Int
  type          String      @default("Crypto")
  sellPrice     Float?
  debit         Float?
  credit        Float?
  tradeDate     DateTime
  status        TradeStatus @default(open)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // relations
  editUser   User   @relation(fields: [editUserId], references: [id])
  editUserId String
}
