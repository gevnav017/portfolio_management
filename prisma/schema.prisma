generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id       String @id @default(cuid())
  name     String
  email    String @unique
  password String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model LiquidPositions {
  id     String @id @default(cuid())
  amount Float

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Stocks {
  id            String  @id @default(cuid())
  symbol        String
  quantity      Int
  purchasePrice Float
  sellPrice     Float?
  status        Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Options {
  id             String   @id @default(cuid())
  symbol         String
  quantity       Int
  tradeDate      DateTime
  expirationDate DateTime
  strike         Float
  side           String
  type           String
  credit         Float
  debit          Float
  status         Boolean  @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Cryptos {
  id            String  @id @default(cuid())
  symbol        String
  purchasePrice Float
  quantity      Int
  sellPrice     Float
  status        Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
